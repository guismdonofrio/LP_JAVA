<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<TabPane prefHeight="520.0" prefWidth="700.0"
         tabClosingPolicy="UNAVAILABLE"
         xmlns="http://javafx.com/javafx/25"
         xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="com.example.projetinho.TelaController">
    <tabs>

        <!-- BARRACA -->
        <Tab text="Barraca de Feira">
            <content>
                <VBox spacing="10" style="-fx-padding: 15;">

                    <Label text="Barraca de Feira"
                           style="-fx-font-weight: bold; -fx-font-size: 15;"/>

                    <HBox spacing="10">
                        <TextField fx:id="txtNomeBarraca"    prefWidth="160" promptText="Nome"/>
                        <TextField fx:id="txtProdutoBarraca" prefWidth="160" promptText="Produto principal"/>
                        <TextField fx:id="txtQuantidadeBarraca" prefWidth="100" promptText="Quantidade"/>
                    </HBox>

                    <HBox spacing="8">
                        <Button text="Vender"         onAction="#venderBarraca"  prefWidth="110"/>
                        <Button text="Repor"          onAction="#reporBarraca"   prefWidth="110"/>
                        <Button text="Editar"        onAction="#editarBarraca" prefWidth="110"/>
                        <Button text="Deletar"        onAction="#deletarBarraca" prefWidth="110"
                                style="-fx-text-fill: red;"/>
                    </HBox>

                    <Label fx:id="lblBarraca" text="---"
                           style="-fx-text-fill: #333; -fx-font-style: italic;"/>

                    <TableView fx:id="tabelaBarraca" prefHeight="260" prefWidth="670">
                        <columns>
                            <TableColumn fx:id="colBarracaId"      text="ID"      prefWidth="50"/>
                            <TableColumn fx:id="colBarracaNome"    text="Nome"    prefWidth="200"/>
                            <TableColumn fx:id="colBarracaProduto" text="Produto" prefWidth="220"/>
                            <TableColumn fx:id="colBarracaEstoque" text="Estoque" prefWidth="100"/>
                        </columns>
                        <placeholder><Label text="Nenhum registro encontrado."/></placeholder>
                    </TableView>

                </VBox>
            </content>
        </Tab>

        <!-- FARMÁCIA -->
        <Tab text="Farmácia">
            <content>
                <VBox spacing="10" style="-fx-padding: 15;">

                    <Label text="Farmácia"
                           style="-fx-font-weight: bold; -fx-font-size: 15;"/>

                    <HBox spacing="10">
                        <TextField fx:id="txtNomeFarmacia"      prefWidth="150" promptText="Nome"/>
                        <TextField fx:id="txtEnderecoFarmacia"  prefWidth="200" promptText="Endereço"/>
                        <TextField fx:id="txtQuantidadeFarmacia" prefWidth="100" promptText="Quantidade"/>
                    </HBox>

                    <HBox spacing="8">
                        <Button text="Comprar"  onAction="#comprarFarmacia"  prefWidth="110"/>
                        <Button text="Vender"   onAction="#venderFarmacia"   prefWidth="110"/>
                        <Button text="Editar"  onAction="#editarFarmacia"  prefWidth="110"/>
                        <Button text="Deletar"  onAction="#deletarFarmacia"  prefWidth="110"
                                style="-fx-text-fill: red;"/>
                    </HBox>

                    <Label fx:id="lblFarmacia" text="---"
                           style="-fx-text-fill: #333; -fx-font-style: italic;"/>

                    <TableView fx:id="tabelaFarmacia" prefHeight="260" prefWidth="670">
                        <columns>
                            <TableColumn fx:id="colFarmaciaId"       text="ID"       prefWidth="50"/>
                            <TableColumn fx:id="colFarmaciaNome"     text="Nome"     prefWidth="160"/>
                            <TableColumn fx:id="colFarmaciaEndereco" text="Endereço" prefWidth="260"/>
                            <TableColumn fx:id="colFarmaciaEstoque"  text="Estoque"  prefWidth="100"/>
                        </columns>
                        <placeholder><Label text="Nenhum registro encontrado."/></placeholder>
                    </TableView>

                </VBox>
            </content>
        </Tab>

        <!-- SALÃO -->
        <Tab text="Salão de Beleza">
            <content>
                <VBox spacing="10" style="-fx-padding: 15;">

                    <Label text="Salão de Beleza"
                           style="-fx-font-weight: bold; -fx-font-size: 15;"/>

                    <HBox spacing="10">
                        <TextField fx:id="txtNomeSalao"         prefWidth="160" promptText="Nome"/>
                        <TextField fx:id="txtFuncionariosSalao" prefWidth="110" promptText="Funcionários"/>
                        <TextField fx:id="txtServicoSalao"      prefWidth="180" promptText="Serviço principal"/>
                    </HBox>

                    <HBox spacing="8">
                        <Button text="Prestar Serviço"      onAction="#prestarServico" prefWidth="140"/>
                        <Button text="Contratar"            onAction="#contratar"      prefWidth="110"/>
                        <Button text="Editar"              onAction="#editarSalao"   prefWidth="110"/>
                        <Button text="Deletar"              onAction="#deletarSalao"   prefWidth="110"
                                style="-fx-text-fill: red;"/>
                    </HBox>

                    <Label fx:id="lblSalao" text="---"
                           style="-fx-text-fill: #333; -fx-font-style: italic;"/>

                    <TableView fx:id="tabelaSalao" prefHeight="260" prefWidth="670">
                        <columns>
                            <TableColumn fx:id="colSalaoId"           text="ID"           prefWidth="50"/>
                            <TableColumn fx:id="colSalaoNome"         text="Nome"         prefWidth="180"/>
                            <TableColumn fx:id="colSalaoFuncionarios" text="Funcionários" prefWidth="110"/>
                            <TableColumn fx:id="colSalaoServico"      text="Serviço"      prefWidth="220"/>
                        </columns>
                        <placeholder><Label text="Nenhum registro encontrado."/></placeholder>
                    </TableView>

                </VBox>
            </content>
        </Tab>

    </tabs>
</TabPane>
