<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<TabPane prefHeight="520.0" prefWidth="700.0" tabClosingPolicy="UNAVAILABLE" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projetinho.TelaController">
    <tabs>

        <!-- BARRACA -->
        <Tab text="Barraca de Feira">
            <content>
                <VBox spacing="10" style="-fx-padding: 15;">
                    <Label style="-fx-font-weight: bold; -fx-font-size: 15;" text="Barraca de Feira" />

                    <HBox spacing="10">
                        <TextField fx:id="txtNomeBarraca" prefWidth="160" promptText="Nome" />
                        <TextField fx:id="txtProdutoBarraca" prefWidth="160" promptText="Produto principal" />
                        <TextField fx:id="txtQuantidadeBarraca" prefWidth="100" promptText="Quantidade" />
                        <Button onAction="#inserirBarraca" prefWidth="90" style="-fx-text-fill: #1565C0;" text="Inserir" />
                  <AnchorPane prefHeight="25.0" prefWidth="99.0" />
                        <Button onAction="#novaBarraca" prefWidth="90" style="-fx-text-fill: green;" text="+ Novo" />
                    </HBox>

                    <Label fx:id="lblBarraca" style="-fx-text-fill: #333; -fx-font-style: italic;" text="---" />

                    <TableView fx:id="tabelaBarraca" editable="true" prefHeight="343.0" prefWidth="670">
                        <columns>
                            <TableColumn fx:id="colBarracaId" prefWidth="50" text="ID" />
                            <TableColumn fx:id="colBarracaNome" prefWidth="200" text="Nome" />
                            <TableColumn fx:id="colBarracaProduto" prefWidth="220" text="Produto" />
                            <TableColumn fx:id="colBarracaEstoque" prefWidth="100" text="Estoque" />
                        </columns>
                        <placeholder><Label text="Nenhum registro encontrado." /></placeholder>
                    </TableView>

                    <HBox spacing="8">
                  <AnchorPane prefHeight="25.0" prefWidth="475.0" />
                        <Button onAction="#editarBarraca" prefWidth="90" text="Editar" />
                        <Button onAction="#deletarBarraca" prefWidth="90.0" style="-fx-text-fill: red;" text="Deletar" />
                    </HBox>
                </VBox>
            </content>
        </Tab>

        <!-- FARMÁCIA -->
        <Tab text="Farmácia">
            <content>
                <VBox spacing="10" style="-fx-padding: 15;">
                    <Label style="-fx-font-weight: bold; -fx-font-size: 15;" text="Farmácia" />

                    <HBox spacing="10">
                        <TextField fx:id="txtNomeFarmacia" prefWidth="150" promptText="Nome" />
                        <TextField fx:id="txtEnderecoFarmacia" prefHeight="25.0" prefWidth="160.0" promptText="Endereço" />
                        <TextField fx:id="txtQuantidadeFarmacia" prefWidth="100" promptText="Quantidade" />
                        <Button onAction="#inserirFarmacia" prefWidth="90" style="-fx-text-fill: #1565C0;" text="Inserir" />
                  <AnchorPane prefHeight="25.0" prefWidth="58.0" />
                        <Button onAction="#novaFarmacia" prefWidth="90" style="-fx-text-fill: green;" text="+ Novo" />
                    </HBox>

                    <Label fx:id="lblFarmacia" style="-fx-text-fill: #333; -fx-font-style: italic;" text="---" />

                    <TableView fx:id="tabelaFarmacia" editable="true" prefHeight="336.0" prefWidth="670">
                        <columns>
                            <TableColumn fx:id="colFarmaciaId" prefWidth="50" text="ID" />
                            <TableColumn fx:id="colFarmaciaNome" prefWidth="160" text="Nome" />
                            <TableColumn fx:id="colFarmaciaEndereco" prefWidth="260" text="Endereço" />
                            <TableColumn fx:id="colFarmaciaEstoque" prefWidth="100" text="Estoque" />
                        </columns>
                        <placeholder><Label text="Nenhum registro encontrado." /></placeholder>
                    </TableView>

                    <HBox spacing="8">
                  <AnchorPane prefHeight="25.0" prefWidth="476.0" />
                        <Button onAction="#editarFarmacia" prefWidth="90" text="Editar" />
                        <Button onAction="#deletarFarmacia" prefWidth="90" style="-fx-text-fill: red;" text="Deletar" />
                    </HBox>
                </VBox>
            </content>
        </Tab>

        <!-- SALÃO -->
        <Tab text="Salão de Beleza">
            <content>
                <VBox spacing="10" style="-fx-padding: 15;">
                    <Label style="-fx-font-weight: bold; -fx-font-size: 15;" text="Salão de Beleza" />

                    <HBox spacing="10">
                        <TextField fx:id="txtNomeSalao" prefWidth="160" promptText="Nome" />
                        <TextField fx:id="txtFuncionariosSalao" prefWidth="110" promptText="Funcionários" />
                        <TextField fx:id="txtServicoSalao" prefWidth="180" promptText="Serviço principal" />
                        <Button onAction="#inserirSalao" prefWidth="90" style="-fx-text-fill: #1565C0;" text="Inserir" />
                  <AnchorPane prefHeight="25.0" prefWidth="121.0" />
                        <Button onAction="#novoSalao" prefWidth="90" style="-fx-text-fill: green;" text="+ Novo" />
                    </HBox>

                    <Label fx:id="lblSalao" style="-fx-text-fill: #333; -fx-font-style: italic;" text="---" />

                    <TableView fx:id="tabelaSalao" editable="true" prefHeight="335.0" prefWidth="670">
                        <columns>
                            <TableColumn fx:id="colSalaoId" prefWidth="50" text="ID" />
                            <TableColumn fx:id="colSalaoNome" prefWidth="180" text="Nome" />
                            <TableColumn fx:id="colSalaoFuncionarios" prefWidth="110" text="Funcionários" />
                            <TableColumn fx:id="colSalaoServico" prefWidth="220" text="Serviço" />
                        </columns>
                        <placeholder><Label text="Nenhum registro encontrado." /></placeholder>
                    </TableView>

                    <HBox spacing="8">
                  <AnchorPane prefHeight="25.0" prefWidth="501.0" />
                        <Button onAction="#editarSalao" prefWidth="90" text="Editar" />
                        <Button onAction="#deletarSalao" prefWidth="90" style="-fx-text-fill: red;" text="Deletar" />
                    </HBox>
                </VBox>
            </content>
        </Tab>

    </tabs>
</TabPane>