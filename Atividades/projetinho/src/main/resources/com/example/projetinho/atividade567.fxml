<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<TabPane maxHeight="-Infinity" maxWidth="-Infinity"
         minHeight="-Infinity" minWidth="-Infinity"
         prefHeight="400.0" prefWidth="600.0"
         tabClosingPolicy="UNAVAILABLE"
         xmlns="http://javafx.com/javafx/25"
         xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="com.example.projetinho.TelaController">

    <tabs>

        <Tab text="Barraca de Feira">
            <content>
                <AnchorPane prefHeight="400.0" prefWidth="600.0">
                    <children>

                        <Label layoutX="250.0" layoutY="30.0" text="Barraca de Feira"/>

                        <TextField fx:id="txtNomeBarraca"
                                   layoutX="225.0" layoutY="60.0"
                                   prefWidth="150.0"
                                   promptText="Nome"/>

                        <TextField fx:id="txtProdutoBarraca"
                                   layoutX="225.0" layoutY="95.0"
                                   prefWidth="150.0"
                                   promptText="Produto principal"/>

                        <TextField fx:id="txtQuantidadeBarraca"
                                   layoutX="225.0" layoutY="130.0"
                                   prefWidth="150.0"
                                   promptText="Quantidade"/>

                        <Button layoutX="225.0" layoutY="190.0"
                                prefWidth="150.0"
                                text="Vender"
                                onAction="#venderBarraca"/>

                        <Button layoutX="225.0" layoutY="225.0"
                                prefWidth="150.0"
                                text="Repor"
                                onAction="#reporBarraca"/>

                        <Button layoutX="225.0" layoutY="260.0"
                                prefWidth="150.0"
                                text="Mostrar Estoque"
                                onAction="#mostrarBarraca"/>

                        <Label layoutX="225.0" layoutY="305.0" text="Resultado:"/>

                        <Label fx:id="lblBarraca"
                               layoutX="225.0" layoutY="325.0"
                               text="---"/>

                    </children>
                </AnchorPane>
            </content>
        </Tab>

        <Tab text="Farmácia">
            <content>
                <AnchorPane prefHeight="400.0" prefWidth="600.0">
                    <children>

                        <Label layoutX="270.0" layoutY="30.0" text="Farmácia"/>

                        <TextField fx:id="txtNomeFarmacia"
                                   layoutX="225.0" layoutY="60.0"
                                   prefWidth="150.0"
                                   promptText="Nome"/>

                        <TextField fx:id="txtEnderecoFarmacia"
                                   layoutX="225.0" layoutY="95.0"
                                   prefWidth="150.0"
                                   promptText="Endereço"/>

                        <TextField fx:id="txtQuantidadeFarmacia"
                                   layoutX="225.0" layoutY="130.0"
                                   prefWidth="150.0"
                                   promptText="Quantidade"/>

                        <Button layoutX="225.0" layoutY="190.0"
                                prefWidth="150.0"
                                text="Comprar"
                                onAction="#comprarFarmacia"/>

                        <Button layoutX="225.0" layoutY="225.0"
                                prefWidth="150.0"
                                text="Vender"
                                onAction="#venderFarmacia"/>

                        <Button layoutX="225.0" layoutY="260.0"
                                prefWidth="150.0"
                                text="Mostrar Estoque"
                                onAction="#mostrarFarmacia"/>

                        <Label layoutX="225.0" layoutY="305.0" text="Resultado:"/>

                        <Label fx:id="lblFarmacia"
                               layoutX="225.0" layoutY="325.0"
                               text="---"/>

                    </children>
                </AnchorPane>
            </content>
        </Tab>

        <Tab text="Salão de Beleza">
            <content>
                <AnchorPane prefHeight="400.0" prefWidth="600.0">
                    <children>

                        <Label layoutX="245.0" layoutY="30.0" text="Salão de Beleza"/>

                        <TextField fx:id="txtNomeSalao"
                                   layoutX="225.0" layoutY="60.0"
                                   prefWidth="150.0"
                                   promptText="Nome"/>

                        <TextField fx:id="txtFuncionariosSalao"
                                   layoutX="225.0" layoutY="95.0"
                                   prefWidth="150.0"
                                   promptText="Funcionários"/>

                        <TextField fx:id="txtServicoSalao"
                                   layoutX="225.0" layoutY="130.0"
                                   prefWidth="150.0"
                                   promptText="Serviço principal"/>

                        <Button layoutX="225.0" layoutY="190.0"
                                prefWidth="150.0"
                                text="Prestar Serviço"
                                onAction="#prestarServico"/>

                        <Button layoutX="225.0" layoutY="225.0"
                                prefWidth="150.0"
                                text="Contratar Funcionário"
                                onAction="#contratar"/>

                        <Button layoutX="225.0" layoutY="260.0"
                                prefWidth="150.0"
                                text="Mostrar Informações"
                                onAction="#mostrarSalao"/>

                        <Label layoutX="225.0" layoutY="305.0" text="Resultado:"/>

                        <Label fx:id="lblSalao"
                               layoutX="225.0" layoutY="325.0"
                               text="---"/>

                    </children>
                </AnchorPane>
            </content>
        </Tab>

    </tabs>
</TabPane>